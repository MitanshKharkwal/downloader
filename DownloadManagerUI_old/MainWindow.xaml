<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="DownloadManagerUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DownloadManagerUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tb="using:H.NotifyIcon"
    Title="DownloadManagerUI"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <tb:TaskbarIcon
            x:Name="TrayIcon"
            IconSource="/Assets/AppIcon.ico"
            ToolTipText="Download Manager"
            NoLeftClickDelay="True"
            LeftClickCommand="{x:Bind ShowWindowCommand}">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Open" Command="{x:Bind ShowWindowCommand}"/>
                    <MenuFlyoutItem Text="Exit" Command="{x:Bind ExitCommand}"/>
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <TitleBar x:Name="AppTitleBar" Title="Download Manager">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView x:Name="NavView" 
                        Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        PaneDisplayMode="Left"
                        SelectionChanged="NavView_SelectionChanged"
                        Loaded="NavView_Loaded">
            
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="Downloads" Content="All Downloads" Icon="Download">
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem Tag="Category_Compressed" Content="Compressed" />
                        <NavigationViewItem Tag="Category_Documents" Content="Documents" />
                        <NavigationViewItem Tag="Category_Music" Content="Music" />
                        <NavigationViewItem Tag="Category_Programs" Content="Programs" />
                        <NavigationViewItem Tag="Category_Video" Content="Video" />
                        <NavigationViewItem Tag="Category_Photos" Content="Photos" />
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
                <NavigationViewItem Tag="Category_Unfinished" Content="Unfinished" Icon="Clock" />
                <NavigationViewItem Tag="Category_Finished" Content="Finished" Icon="Accept" />
            </NavigationView.MenuItems>

            <Frame x:Name="RootFrame">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition />
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </NavigationView>
    </Grid>
</Window>
