<!--
  Injected into AndroidManifest.xml's main activity by buildozer
  (android.manifest.intent_filters in buildozer.spec). This is what
  makes Android offer this app as a handler whenever the user taps a
  magnet: link or opens/downloads a .torrent file, in any other app --
  the same role the Chrome extension + native messaging host play on
  Windows.
-->

<!-- magnet: links tapped anywhere (browser, chat app, file manager, ...) -->
<intent-filter>
    <action android:name="android.intent.action.VIEW" />
    <category android:name="android.intent.category.DEFAULT" />
    <category android:name="android.intent.category.BROWSABLE" />
    <data android:scheme="magnet" />
</intent-filter>

<!-- .torrent files opened from a file manager or "Open with" dialog,
     arriving as a content:// URI with the standard BitTorrent MIME type -->
<intent-filter>
    <action android:name="android.intent.action.VIEW" />
    <category android:name="android.intent.category.DEFAULT" />
    <data android:mimeType="application/x-bittorrent" />
</intent-filter>

<!-- .torrent files served directly over http(s) that the browser offers
     to open with an installed app rather than downloading silently -->
<intent-filter>
    <action android:name="android.intent.action.VIEW" />
    <category android:name="android.intent.category.DEFAULT" />
    <category android:name="android.intent.category.BROWSABLE" />
    <data android:scheme="http" android:pathPattern=".*\\.torrent" />
    <data android:scheme="https" android:pathPattern=".*\\.torrent" />
</intent-filter>
