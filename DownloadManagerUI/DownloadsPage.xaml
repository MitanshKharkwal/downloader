<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DownloadManagerUI.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DownloadManagerUI"
    xmlns:models="using:DownloadManagerUI.Models"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:dg="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical" Spacing="4" Margin="0,0,0,24">
            <TextBlock Text="Downloads" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Manage and monitor your active downloads" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <InfoBar x:Name="DaemonOfflineBar" 
                     Title="Daemon Offline" 
                     Message="The download manager background service is not running. Please launch start.bat." 
                     Severity="Error" 
                     IsOpen="False" 
                     IsClosable="False" 
                     Margin="0,12,0,0"/>
            <InfoBar x:Name="LoadingVideoBar" 
                     Title="Fetching Video Info..." 
                     Message="Please wait, retrieving available formats from yt-dlp..." 
                     Severity="Informational" 
                     IsOpen="False" 
                     IsClosable="False" 
                     Margin="0,12,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,24" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <TextBox x:Name="UrlInput" PlaceholderText="Enter download URL or magnet link..." KeyDown="UrlInput_KeyDown" />
            <Button Grid.Column="1" Content="Download" Style="{StaticResource AccentButtonStyle}" Click="AddDownload_Click" />
            <Button Grid.Column="2" Content="Pause All" Click="PauseAll_Click" Margin="4,0,0,0" />
            <Button Grid.Column="3" Content="Resume All" Click="ResumeAll_Click" Margin="4,0,0,0" />
            <Button Grid.Column="4" Content="Clear Finished" Click="ClearFinished_Click" Margin="4,0,0,0" />
        </Grid>

        <dg:DataGrid x:Name="TasksList" 
                         Grid.Row="2"
                         ItemsSource="{x:Bind FilteredTasks}" 
                         AutoGenerateColumns="False" 
                         CanUserSortColumns="True" 
                         CanUserResizeColumns="True" 
                         IsReadOnly="True" 
                         GridLinesVisibility="Horizontal" 
                         HeadersVisibility="Column" 
                         SelectionMode="Single"
                         DoubleTapped="TasksList_DoubleTapped">
                <dg:DataGrid.Columns>
                    <dg:DataGridTextColumn Header="File Name" Binding="{Binding Filename}" Width="250" />
                    <dg:DataGridTextColumn Header="Q" Binding="{Binding Q}" Width="50" />
                    <dg:DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="120" />
                    <dg:DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                    <dg:DataGridTemplateColumn Header="Progress" Width="150">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Padding="8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar Value="{Binding Progress}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding ProgressText}" VerticalAlignment="Center" FontSize="12" MinWidth="45" TextAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                    </dg:DataGridTemplateColumn>
                    <dg:DataGridTextColumn Header="Time left" Binding="{Binding ETAText}" Width="120" />
                    <dg:DataGridTextColumn Header="Transfer rate" Binding="{Binding SpeedText}" Width="100" />
                    <dg:DataGridTextColumn Header="Last Try Date" Binding="{Binding LastTryDate}" Width="120" />
                    <dg:DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="150" />
                    <dg:DataGridTextColumn Header="Date Added" Binding="{Binding DateAdded}" Width="120" />

                    <dg:DataGridTemplateColumn Header="Actions" Width="*">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Padding="4">
                                    <Button Content="&#xE769;" FontFamily="Segoe MDL2 Assets" ToolTipService.ToolTip="Pause" Tag="{Binding Id}" Click="Pause_Click" Background="Transparent" BorderThickness="0" Padding="4" />
                                    <Button Content="&#xE768;" FontFamily="Segoe MDL2 Assets" ToolTipService.ToolTip="Resume" Tag="{Binding Id}" Click="Resume_Click" Background="Transparent" BorderThickness="0" Padding="4" />
                                    <Button Content="&#xE149;" FontFamily="Segoe MDL2 Assets" ToolTipService.ToolTip="Retry" Tag="{Binding Id}" Click="Retry_Click" Background="Transparent" BorderThickness="0" Padding="4" />
                                    <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" ToolTipService.ToolTip="Cancel" Tag="{Binding Id}" Click="Cancel_Click" Background="Transparent" BorderThickness="0" Padding="4" />
                                    <Button Content="&#xE8B7;" FontFamily="Segoe MDL2 Assets" ToolTipService.ToolTip="Open Folder" Tag="{Binding FilePath}" Click="OpenFolder_Click" Background="Transparent" BorderThickness="0" Padding="4" />
                                    <Button Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets" ToolTipService.ToolTip="Copy URL" Tag="{Binding Source}" Click="CopyUrl_Click" Background="Transparent" BorderThickness="0" Padding="4" />
                                </StackPanel>
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                    </dg:DataGridTemplateColumn>
                </dg:DataGrid.Columns>
            </dg:DataGrid>
        
        <ContentDialog x:Name="VideoFormatDialog"
                       Title="Select Video Quality"
                       PrimaryButtonText="Download"
                       CloseButtonText="Cancel"
                       DefaultButton="Primary">
            <StackPanel Spacing="12">
                <TextBlock x:Name="VideoTitleText" TextWrapping="Wrap" FontWeight="SemiBold" />
                <ComboBox x:Name="VideoTypeComboBox" Header="Download Type" Width="400" SelectedIndex="0">
                    <x:String>Video + Audio</x:String>
                    <x:String>Audio Only</x:String>
                    <x:String>Video Only</x:String>
                </ComboBox>
                <ComboBox x:Name="VideoQualityComboBox" Header="Max Quality" Width="400" SelectedIndex="3">
                    <x:String>Best Available</x:String>
                    <x:String>4K (2160p)</x:String>
                    <x:String>1440p</x:String>
                    <x:String>1080p</x:String>
                    <x:String>720p</x:String>
                    <x:String>480p</x:String>
                    <x:String>360p</x:String>
                </ComboBox>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
