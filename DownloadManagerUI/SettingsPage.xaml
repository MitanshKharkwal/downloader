<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DownloadManagerUI.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DownloadManagerUI"
    xmlns:models="using:DownloadManagerUI.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">
        <ScrollViewer>
            <StackPanel Orientation="Vertical" Spacing="24" MaxWidth="600" HorizontalAlignment="Left">
            <StackPanel Orientation="Vertical" Spacing="4">
                <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Configure global application preferences" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Spacing="16">
                <TextBox x:Name="DownloadDirInput" Header="Download Directory" PlaceholderText="C:\Downloads" />
                <NumberBox x:Name="MaxConcurrentInput" Header="Max Concurrent Downloads" Minimum="1" Maximum="20" SpinButtonPlacementMode="Inline" />
                <NumberBox x:Name="SpeedLimitInput" Header="Global Speed Limit (Bytes/s, 0 for unlimited)" Minimum="0" SpinButtonPlacementMode="Inline" />
                
                <Button Content="Save Settings" Style="{StaticResource AccentButtonStyle}" Click="SaveSettings_Click" Margin="0,16,0,0"/>
                
                <TextBlock Text="Columns" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,24,0,0"/>
                <TextBlock Text="Check the columns that you would like visible. Use Move Up/Down to reorder." Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <ListView x:Name="ColumnsListView" Grid.Column="0" SelectionMode="Single" Height="250" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" CanDragItems="True" CanReorderItems="True" AllowDrop="True">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ColumnConfig">
                                <Grid HorizontalAlignment="Stretch" MinWidth="300">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" Content="{Binding Header}" IsChecked="{Binding IsVisible, Mode=TwoWay}" Checked="ColumnConfig_Changed" Unchecked="ColumnConfig_Changed" Margin="0" MinHeight="32" VerticalAlignment="Center"/>
                                    <FontIcon Grid.Column="1" Glyph="&#xE762;" FontSize="16" FontFamily="{ThemeResource SymbolThemeFontFamily}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>

                <InfoBar x:Name="SaveSuccessBar" Title="Settings saved" Severity="Success" IsOpen="False" Margin="0,16,0,0" />
            </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
