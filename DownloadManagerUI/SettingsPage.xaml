<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DownloadManagerUI.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DownloadManagerUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">
        <StackPanel Orientation="Vertical" Spacing="24" MaxWidth="600" HorizontalAlignment="Left">
            <StackPanel Orientation="Vertical" Spacing="4">
                <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Configure global application preferences" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Spacing="16">
                <TextBox x:Name="DownloadDirInput" Header="Download Directory" PlaceholderText="C:\Downloads" />
                <NumberBox x:Name="MaxConcurrentInput" Header="Max Concurrent Downloads" Minimum="1" Maximum="20" SpinButtonPlacementMode="Inline" />
                <NumberBox x:Name="SpeedLimitInput" Header="Global Speed Limit (Bytes/s, 0 for unlimited)" Minimum="0" SpinButtonPlacementMode="Inline" />
                
                <Button Content="Save Settings" Style="{StaticResource AccentButtonStyle}" Click="SaveSettings_Click" Margin="0,16,0,0"/>
                
                <InfoBar x:Name="SaveSuccessBar" Title="Settings saved" Severity="Success" IsOpen="False" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
